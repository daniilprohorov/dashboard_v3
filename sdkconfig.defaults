# Target: Waveshare ESP32-S3-Touch-LCD-7B (ESP32-S3-WROOM-1-N16R8).
# Source of truth for config; sdkconfig is generated and git-ignored.
# Perf flags follow vendor example 17_lvgl_v9_demo (docs/vendor/).
CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB QIO @120M (needs experimental features, must match PSRAM speed)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_BOOTLOADER_FLASH_DC_AWARE=y
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM 8MB octal @120M, code+rodata executed from PSRAM (keeps RGB DMA stable during flash ops)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# CONFIG_SPIRAM_MEMTEST is not set
# Adapter RGB-panel callback context must be internal; small mallocs stay internal.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# CPU / cache / RTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# RGB LCD
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# LVGL 9
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

# Dashboard
CONFIG_DASH_DEMO=y
CONFIG_DASH_CAN_BITRATE=500000
CONFIG_DASH_FUEL_TANK_L=50
CONFIG_DASH_RPM_LIMIT=6000
